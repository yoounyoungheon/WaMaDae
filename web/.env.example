# Next.js BFF가 호출할 mysom-api 주소. 서버 전용이므로 NEXT_PUBLIC_ 접두사를 사용하지 않는다.
MYSOM_API_BASE_URL=http://localhost:8080

# 와인 DB(카탈로그/와인21) 매칭 데이터 제외 여부.
# true(기본): 추출 단계에서 카탈로그 매칭 항목(isCatalogMatched)을 제외하고 순수 OCR 항목만 사용하며,
#            추천 상세 카드의 와인 정보(품종/빈티지/도수) 영역을 "준비 중" 오버레이로 덮는다.
# false     : 카탈로그 데이터를 포함하고 실제 정보를 표시한다.
# NEXT_PUBLIC_ 값이라 BFF(서버)와 클라이언트가 함께 읽는다. 변경 후 dev 서버/빌드 재시작 필요.
NEXT_PUBLIC_WINE_EXCLUDE_CATALOG=false
