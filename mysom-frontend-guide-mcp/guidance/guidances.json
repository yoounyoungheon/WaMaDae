    {
      "id": "data-flow-layering",
      "title": "프론트엔드 상태 관리 가이드",
      "summary": "서버 상태는 TanStack Query, 공유 클라이언트 UI 상태는 Zustand, 컴포넌트 내부 상태는 useState, 공유 가능한 조건은 searchParams로 관리합니다.",
      "triggers": {
        "paths": [
          "web/src/app/**/hooks/**",
          "web/src/app/**/business/**",
          "web/src/app/**/api/**",
          "web/src/app/**/model/**",
          "web/src/app/**/providers.tsx",
          "web/src/app/**/page.tsx",
          "web/src/app/**/layout.tsx"
        ],
        "keywords": [
          "tanstack query",
          "react query",
          "zustand",
          "query key",
          "querykey",
          "usequery",
          "usemutation",
          "invalidatequeries",
          "server state",
          "client state",
          "ui state",
          "state management",
          "searchparams",
          "상태 관리",
          "서버 상태",
          "클라이언트 상태",
          "data flow",
          "layering"
        ]
      },
      "sources": ["guidance/data-flow-layering.md"],
      "canonicalSources": ["guidance/data-flow-layering.md"],
      "guideFiles": ["guidance/data-flow-layering.md"]
    },
